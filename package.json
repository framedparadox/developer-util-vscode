        "menus": {
            "editor/title": [
                {
                    "command": "devx.visualizerFromFile",
                    "when": "resourceLangId == json || resourceLangId == jsonc || resourceLangId == yaml || resourceLangId == xml || resourceExtname == .csv || resourceExtname == .raml",
                    "group": "navigation"
                }
            ],
            "view/title": [
                {
                    "command": "devx.refreshTools",
                    "when": "view == devxToolsView",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run typecheck && npm run package",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "typecheck": "tsc --noEmit -p .",
        "pretest": "npm run typecheck && npm run compile-tests && npm run compile && npm run lint",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vscode-test",
        "build": "webpack --mode development",
        "package:vsix": "vsce package --no-dependencies"
    },
    "devDependencies": {
