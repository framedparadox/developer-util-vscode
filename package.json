    "publisher": "framedparadox",
    "license": "MIT",
    "icon": "resources/electric.png",
    "keywords": [
        "developer",
        "aes",
        "encrypt",
        "decrypt",
        "base64",
        "jwt",
        "uuid",
        "formatter",
        "xml",
        "json",
        "yaml",
        "csv",
        "certificate",
        "developer tools",
        "hash",
