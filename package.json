        "@types/node": "22.x",
        "@types/papaparse": "^5.5.2",
        "@types/qrcode": "^1.5.6",
        "@types/vscode": "1.105.0",
        "@typescript-eslint/eslint-plugin": "^8.62.1",
        "@typescript-eslint/parser": "^8.62.1",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/vsce": "^3.9.2",
        "eslint": "^9.39.4",
        "ovsx": "^1.0.2",
        "prettier": "^3.9.4",
        "ts-loader": "^9.6.2",
        "typescript": "^5.9.3",
        "webpack": "^5.108.3",
        "webpack-cli": "^6.0.1"
    },
